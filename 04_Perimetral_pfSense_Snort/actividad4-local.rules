# =====================================================================
# Actividad 4 - Reglas personalizadas de Snort 2.9 (paquete Snort de pfSense)
# Objetivo: detectar escaneos de puertos y barridos de red (reconocimiento)
# Cargar en: Services > Snort > (interfaz) > Rules > Category: custom.rules
# SIDs locales: 1000001-1000099. Probar SOLO contra equipos del laboratorio.
# =====================================================================

# 1) Escaneo SYN (nmap -sS): una misma IP envia muchos SYN a $HOME_NET en poco tiempo.
#    threshold "both": una sola alerta por origen cada 5 s al superar 30 SYN.
alert tcp any any -> $HOME_NET any (msg:"ACT4 SCAN Escaneo SYN de puertos (posible nmap -sS)"; flow:stateless; flags:S,12; threshold:type both, track by_src, count 30, seconds 5; classtype:attempted-recon; sid:1000001; rev:1;)

# 2) Escaneo NULL (nmap -sN): segmento TCP sin ninguna bandera; nunca es trafico legitimo.
alert tcp any any -> $HOME_NET any (msg:"ACT4 SCAN Escaneo TCP NULL (posible nmap -sN)"; flow:stateless; flags:0; threshold:type limit, track by_src, count 1, seconds 60; classtype:attempted-recon; sid:1000002; rev:1;)

# 3) Escaneo FIN (nmap -sF): solo FIN sin ACK; el cierre legitimo siempre lleva ACK.
alert tcp any any -> $HOME_NET any (msg:"ACT4 SCAN Escaneo TCP FIN (posible nmap -sF)"; flow:stateless; flags:F,12; threshold:type limit, track by_src, count 1, seconds 60; classtype:attempted-recon; sid:1000003; rev:1;)

# 4) Escaneo XMAS (nmap -sX): FIN + PSH + URG encendidos a la vez.
alert tcp any any -> $HOME_NET any (msg:"ACT4 SCAN Escaneo TCP XMAS (posible nmap -sX)"; flow:stateless; flags:FPU,12; threshold:type limit, track by_src, count 1, seconds 60; classtype:attempted-recon; sid:1000004; rev:1;)

# 5) Escaneo UDP (nmap -sU): rafaga de datagramas UDP desde un mismo origen.
alert udp any any -> $HOME_NET !53 (msg:"ACT4 SCAN Rafaga UDP a multiples puertos (posible nmap -sU)"; threshold:type both, track by_src, count 40, seconds 5; classtype:attempted-recon; sid:1000005; rev:1;)

# 6) Barrido de red con ICMP echo (nmap -sn): muchos ping desde un mismo origen.
alert icmp any any -> $HOME_NET any (msg:"ACT4 SCAN Barrido ICMP de hosts (posible nmap -sn)"; itype:8; threshold:type both, track by_src, count 10, seconds 5; classtype:attempted-recon; sid:1000006; rev:1;)

# 7) Movimiento lateral: un dispositivo IoT intenta conectarse a la red interna (VLAN 30 -> VLAN 20).
#    Complementa al firewall: el paquete se bloquea, pero el IDS deja evidencia del intento.
alert tcp 192.168.30.0/24 any -> 192.168.20.0/24 any (msg:"ACT4 POLICY Intento de conexion IoT hacia red interna"; flow:stateless; flags:S,12; threshold:type limit, track by_src, count 1, seconds 60; classtype:policy-violation; sid:1000007; rev:1;)
