        {
          "name": "Token con claims alterados (escalada a admin)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/citas?paciente=101",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "citas"
              ],
              "query": [
                {
                  "key": "paciente",
                  "value": "101"
                }
              ]
            },
            "description": "Se modifica el payload (scope admin) conservando la firma original: el servidor debe rechazarlo.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tampered_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b64urlDecode = s => CryptoJS.enc.Base64.parse(s.replace(/-/g, '+').replace(/_/g, '/') + '==='.slice((s.length + 3) % 4)).toString(CryptoJS.enc.Utf8);",
                  "const b64urlEncode = s => CryptoJS.enc.Base64.stringify(CryptoJS.enc.Utf8.parse(s)).replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
                  "const [h, p, s] = pm.collectionVariables.get('user_token').split('.');",
                  "const pl = JSON.parse(b64urlDecode(p)); pl.scope = 'citas:read citas:write admin';",
                  "pm.variables.set('tampered_token', [h, b64urlEncode(JSON.stringify(pl)), s].join('.'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 token_invalido', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Token con alg none (sin firma)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/citas?paciente=101",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "citas"
              ],
              "query": [
                {
                  "key": "paciente",
                  "value": "101"
                }
              ]
            },
            "description": "Verifica que la lista blanca de algoritmos rechaza tokens sin firma.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{none_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b64urlDecode = s => CryptoJS.enc.Base64.parse(s.replace(/-/g, '+').replace(/_/g, '/') + '==='.slice((s.length + 3) % 4)).toString(CryptoJS.enc.Utf8);",
                  "const b64urlEncode = s => CryptoJS.enc.Base64.stringify(CryptoJS.enc.Utf8.parse(s)).replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
                  "const p = pm.collectionVariables.get('user_token').split('.')[1];",
                  "pm.variables.set('none_token', b64urlEncode(JSON.stringify({ alg: 'none', typ: 'JWT' })) + '.' + p + '.');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 token_invalido', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
