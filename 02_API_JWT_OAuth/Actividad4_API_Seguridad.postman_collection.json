{
  "info": {
    "_postman_id": "35cba251-f950-5bf9-b468-9cb3b1d3cf4a",
    "name": "Actividad 4 – Pruebas de seguridad de API (ClinicApp)",
    "description": "Pruebas de JWT, OAuth 2.0 (client credentials), validación de entradas y rate limiting contra la API de laboratorio en http://localhost:3000. Orden: 01 → 02 → 03; la carpeta 04 se ejecuta aparte en el Runner con 110 iteraciones.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Autenticación (OAuth 2.0 y JWT)",
      "item": [
        {
          "name": "OAuth 2.0 – obtener token (client_credentials)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/oauth/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "oauth",
                "token"
              ]
            },
            "description": "Flujo Client Credentials (RFC 6749 §4.4). Guarda el access_token en la variable de colección.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials",
                  "type": "text"
                },
                {
                  "key": "client_id",
                  "value": "{{client_id}}",
                  "type": "text"
                },
                {
                  "key": "client_secret",
                  "value": "{{client_secret}}",
                  "type": "text"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b64urlDecode = s => CryptoJS.enc.Base64.parse(s.replace(/-/g, '+').replace(/_/g, '/') + '==='.slice((s.length + 3) % 4)).toString(CryptoJS.enc.Utf8);",
                  "const b64urlEncode = s => CryptoJS.enc.Base64.stringify(CryptoJS.enc.Utf8.parse(s)).replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('token_type Bearer y vida <= 15 min', () => { pm.expect(j.token_type).to.eql('Bearer'); pm.expect(j.expires_in).to.be.at.most(900); });",
                  "pm.test('Cache-Control: no-store', () => pm.expect(pm.response.headers.get('Cache-Control')).to.include('no-store'));",
                  "const [h, p] = j.access_token.split('.');",
                  "pm.test('Firmado con HS256 e incluye iss/aud/exp', () => { const hdr = JSON.parse(b64urlDecode(h)); const pl = JSON.parse(b64urlDecode(p)); pm.expect(hdr.alg).to.eql('HS256'); pm.expect(pl).to.include.keys('iss', 'aud', 'exp', 'scope'); });",
                  "pm.collectionVariables.set('access_token', j.access_token);"
                ]
              }
            }
          ]
        },
