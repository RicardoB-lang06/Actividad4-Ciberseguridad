    {
      "name": "04 Rate limiting (100 solicitudes/minuto)",
      "description": "Ejecutar esta carpeta SOLA en el Collection Runner con 110 iteraciones, 0 ms de retraso, después de esperar 60 s sin usar la API.",
      "item": [
        {
          "name": "Ráfaga contra /api/citas",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/citas?paciente=101",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "citas"
              ],
              "query": [
                {
                  "key": "paciente",
                  "value": "101"
                }
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('access_token')) {",
                  "  pm.sendRequest({ url: pm.collectionVariables.get('baseUrl') + '/oauth/token', method: 'POST',",
                  "    body: { mode: 'urlencoded', urlencoded: [ { key: 'grant_type', value: 'client_credentials' }, { key: 'client_id', value: pm.collectionVariables.get('client_id') }, { key: 'client_secret', value: pm.collectionVariables.get('client_secret') } ] } },",
                  "    (err, res) => { if (!err && res.code === 200) pm.collectionVariables.set('access_token', res.json().access_token); });",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const n = pm.info.iteration; // 0..109",
                  "if (n < 90) { pm.test(`Iteración ${n + 1}: dentro del límite (200)`, () => pm.response.to.have.status(200)); }",
                  "else if (n >= 100) { pm.test(`Iteración ${n + 1}: bloqueada (429)`, () => { pm.response.to.have.status(429); pm.expect(pm.response.headers.has('Retry-After')).to.be.true; }); }",
                  "else { pm.test(`Iteración ${n + 1}: 200 o 429 según solicitudes previas en la ventana`, () => pm.expect([200, 429]).to.include(pm.response.code)); }",
                  "console.log(`#${n + 1} -> ${pm.response.code} | ${pm.response.headers.get('RateLimit')}`);"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
